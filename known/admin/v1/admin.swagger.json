    "/builtin/admin/api/v1/users/{user.id}": {
      "patch": {
        "operationId": "KnownAdmin_UpdateUser",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1User"
            }
          },
          "4xx": {
            "description": "客户端参数异常",
            "schema": {
              "$ref": ".grpc_kit.api.known.status.v1.ErrorResponse"
            }
          },
          "5xx": {
            "description": "服务端处理异常",
            "schema": {
              "$ref": ".grpc_kit.api.known.status.v1.ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "user.id",
            "description": "ID 用户 ID，全局唯一标识",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "user",
            "description": "User 用户实体，表示系统中的账号信息",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string",
                  "title": "用户名，系统登录凭证，通常唯一"
                },
                "status": {
                  "$ref": "#/definitions/v1UserStatus",
                  "title": "用户状态，表示当前账号的生命周期阶段"
                },
                "realname": {
                  "type": "string",
                  "title": "真实姓名，用于实名认证或后台展示"
                },
                "idcard": {
                  "type": "string",
                  "title": "身份证号，用于身份验证（可选）"
                },
                "nickname": {
                  "type": "string",
                  "title": "昵称，用于社交或前端展示"
                },
                "profile": {
                  "type": "string",
                  "title": "个人简介或签名"
                },
                "picture": {
                  "type": "string",
                  "title": "用户头像 URL"
                },
                "website": {
                  "type": "string",
                  "title": "个人网站地址"
                },
                "email": {
                  "type": "string",
                  "title": "邮箱地址"
                },
                "email_verified": {
                  "type": "boolean",
                  "title": "邮箱是否已验证"
                },
                "gender": {
                  "$ref": "#/definitions/v1Gender",
                  "title": "性别"
                },
                "birthday": {
                  "type": "string",
                  "format": "date-time",
                  "title": "出生日期"
                },
                "zoneinfo": {
                  "type": "string",
                  "title": "时区信息（IANA 时区标识，例如 \"Asia/Shanghai\"）"
                },
                "locale": {
                  "type": "string",
                  "title": "用户偏好的语言与地区（例如 \"zh-CN\"、\"en-US\"）"
                },
                "phone_number": {
                  "$ref": "#/definitions/v1PhoneNumber",
                  "title": "手机号码"
                },
                "phone_number_verified": {
                  "type": "boolean",
                  "title": "手机号码是否已验证"
                },
                "address": {
                  "$ref": "#/definitions/v1Address",
                  "title": "地址信息"
                },
                "department": {
                  "$ref": "#/definitions/v1Department",
                  "title": "所属部门"
                }
              },
              "title": "User 用户实体，表示系统中的账号信息"
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "AuthProviderProviderType": {
      "type": "string",
      "enum": [
        "LOCAL",
        "LDAP",
        "OIDC",
        "OAUTH2",
        "GITHUB",
        "GOOGLE",
        "WECHAT"
      ],
      "default": "LOCAL"
    },
    "ListUsersRequestUserView": {
      "type": "string",
      "enum": [
        "USER_VIEW_UNSPECIFIED",
        "USER_VIEW_BASIC",
        "USER_VIEW_FULL"
      ],
      "default": "USER_VIEW_UNSPECIFIED",
      "title": "控制资源返回的详细程度。"
    },
    "v1Address": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "locality": {
          "type": "string"
        },
        "street_address": {
          "type": "string"
        }
      },
      "title": "Address 用户地址\nhttps://openid.net/specs/openid-connect-core-1_0.html#AddressClaim"
    },
    "v1AuthProvider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/AuthProviderProviderType"
        },
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "redirect_uri": {
          "type": "string"
        },
        "scopes": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "authorization_endpoint": {
          "type": "string"
        },
        "token_endpoint": {
          "type": "string"
        },
        "userinfo_endpoint": {
          "type": "string"
        }
      }
    },
    "v1CreateAuthLoginRequest": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "title": "Username 系统识别的用户名全局唯一"
        },
        "email": {
          "type": "string",
          "title": "Email 用户邮箱地址"
        },
        "phone_number": {
          "type": "string",
          "title": "PhoneNumber 用户手机号"
        },
        "expires_in": {
          "type": "integer",
          "format": "int32",
          "title": "ExpiresIn 控制生成 access_token 的有效时长，默认 24 * 60 * 60 秒"
        },
        "password_hash": {
          "type": "string",
          "title": "PasswordHash 用户密码在本地使用 sha256 哈希结果"
        }
      },
      "title": "CreateAuthLoginRequest 用于登录请求，所有用户均可"
    },
    "v1CreateAuthLoginResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string"
        },
        "token_type": {
          "type": "string"
        },
        "expires_in": {
          "type": "integer",
          "format": "int32"
        }
      },
      "title": "CreateAuthLoginResponse 登录成功响应\n参考 rfc 规范：https://www.rfc-editor.org/rfc/rfc6749#section-5"
    },
    "v1CreateAuthTokenRequest": {
      "type": "object",
      "properties": {
        "appid": {
          "type": "string",
          "title": "Appid 关联应用标识"
        },
        "username": {
          "type": "string",
          "title": "Username 系统识别的用户名全局唯一"
        },
        "email": {
          "type": "string",
          "title": "Email 用户邮箱地址"
        },
        "phone_number": {
          "type": "string",
          "title": "PhoneNumber 用户手机号"
        },
        "expires_in": {
