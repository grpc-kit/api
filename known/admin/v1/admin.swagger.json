    "v1Menu": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "title": "ID 菜单 ID"
        },
        "parent_id": {
          "type": "integer",
          "format": "int32",
          "title": "ParentID 父菜单 ID，为 0 表示顶级菜单"
        },
        "name": {
          "type": "string",
          "title": "Name 菜单名称"
        },
        "path": {
          "type": "string",
          "title": "Path 菜单路径"
        },
        "i18n_name": {
          "type": "string",
          "title": "I18NName 国际化名称"
        },
        "icon": {
          "type": "string",
          "title": "Icon 菜单图标，通常用于前端展示"
        },
        "order_weight": {
          "type": "integer",
          "format": "int32",
          "title": "OrderWeight 菜单排序权重，数字越小越靠前"
        },
        "type": {
          "$ref": "#/definitions/v1MenuType",
          "title": "Type 菜单用途，如后台管理员、前台用户、APP 应用"
        },
        "enabled": {
          "type": "boolean",
          "title": "Enabled 菜单是否启用"
        },
        "hide_in_menu": {
          "type": "boolean",
          "title": "HideInMenu 是否在菜单列表中隐藏"
        },
        "hide_children_in_menu": {
          "type": "boolean",
          "title": "HideChildrenInMenu 是否在菜单列表中隐藏子菜单"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Menu"
          },
          "title": "Children 子菜单列表"
        }
      },
      "title": "Menu 用户后台菜单"
    },
    "v1MenuType": {
      "type": "string",
      "enum": [
        "MENU_TYPE_UNSPECIFIED",
        "MENU_TYPE_ADMIN",
        "MENU_TYPE_USER"
      ],
      "default": "MENU_TYPE_UNSPECIFIED",
      "description": "- MENU_TYPE_UNSPECIFIED: 未指定类型，保留为默认值\n - MENU_TYPE_ADMIN: 后台菜单\n - MENU_TYPE_USER: 用户菜单",
      "title": "MenuType 菜单类型"
    },
