    "/builtin/admin/api/v1/users": {
      "get": {
        "operationId": "KnownAdmin_ListUsers",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListUsersResponse"
            }
          },
          "4xx": {
            "description": "客户端参数异常",
